### Chandrapatlu
@article{Chandrupatla1,
title = {A new hybrid quadratic/bisection algorithm for finding the zero of a nonlinear function without using derivatives},
journal = {Advances in Engineering Software},
volume = {28},
number = {3},
pages = {145-149},
year = {1997},
issn = {0965-9978},
doi = {10.1016/S0965-9978(96)00051-8},
url = {https://www.sciencedirect.com/science/article/pii/S0965997896000518},
author = {Tirupathi R. Chandrupatla},
keywords = {zero finding, root finding, nonlinear functions},
abstract = {A new algorithm for finding the zero of a nonlinear function without using derivatives is presented here. The algorithm starts after an initial interval bracketing the zero has been established. We start with an initial bisection step. Using the two new interval points and the point just discarded, conditions for the applicability of inverse quadratic interpolation are checked. These conditions are systematically developed and derived in the paper. Inverse quadratic interpolation is used if applicable and bisection is used otherwise. The algorithm has been tried on several test functions and compared with Brent's algorithm for the same convergence criteria.}
}

